{
  "_schema_version": "1.0",
  "_description": "WALS feature-value substructure annotations for the Grambank2Vec thesis. All value strings are verified against checkpoints/wals_learned_s42/featvalue2id.json. Covering 61 WALS features across 4 structure types.",
  "_structure_types": {
    "ordinal": "Values form a scale. 'values' maps each value string to its integer rank (0 = smallest/least).",
    "presence_subtype": "First split is absent vs present; present values subdivide into subtypes. 'triplets' lists (anchor, near, far) triples where near should be closer to anchor than far.",
    "boolean_lattice": "Values are combinations of binary components. 'components' names each component; 'values' maps each value string to its multi-hot vector.",
    "permutation": "Values encode order, position, or cross-product axes. 'values' maps each value string to a dict of {axis_name: label}; 'axes' lists which axes to probe."
  },
  "_diagnostic_functions": {
    "ordinal": "ordinal_spearman(E, value_index, spec['values'])",
    "presence_subtype": "triplet_accuracy(E, value_index, spec['triplets'])",
    "boolean_lattice": "lattice_r2(E, value_index, spec['values'], spec['components'])",
    "permutation": "cross_product_probe(E, value_index, spec['values'], spec['axes'])"
  },
  "_centering_note": "All diagnostics operate on within-feature-centred embeddings: E_centred = E_raw - E_raw.mean(axis=0). This removes the feature-level offset so that geometry reflects within-feature value structure rather than feature identity.",
  "_results_summary": {
    "seeds_tested": [
      42,
