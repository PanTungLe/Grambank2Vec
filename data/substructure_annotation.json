      "ordinal_features_learned_beats_tcf": "1A, 3A, 22A, 26A, 30A, 40A, 49A, 53A (ρ > +0.4; T-CF near-zero or negative)",
      "strongest_dissociation": "22A: Learned +0.52, T-CF -0.45 (sign reversal); 40A: Learned +0.41, T-CF -0.59",
      "presence_subtype_learned_1000": "9A, 13A, 31A, 32A, 37A, 38A, 55A, 68A, 77A, 78A, 108A all at 1.000 ± 0.000",
      "permutation_standout": "84A verb_pos: Learned 1.000, T-CF 0.550; 71A neg_type: Learned 1.000, T-CF 0.750",
      "lattice_best": "102A: Learned R² -0.817 vs T-CF -2.297 (Learned less negative by 1.48)"
    }
